{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "依存の更新の PR を Renovate に出させる。CI が通れば自動で入れ、人が見るのはメジャーだけ（docs/development.md の「依存の更新」）。packageRules は後に書いたものが前のものを上書きする。",
  "extends": ["config:recommended"],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 9am on monday"],
  "minimumReleaseAge": "7 days",
  "prConcurrentLimit": 20,
  "packageRules": [
    {
      "description": "web の本番の依存のパッチ・マイナー",
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "web の本番の依存",
      "groupSlug": "web",
      "labels": ["自動マージ"],
      "automerge": true
    },
    {
      "description": "iOS でだけ使う依存のうち、Expo の SDK が版を決めていないもの",
      "matchDepTypes": ["dependencies"],
      "matchPackageNames": [
        "expo-share-intent",
        "@react-native-google-signin/*",
        "@tanstack/react-query",
        "use-intl"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "iOS の依存",
      "groupSlug": "ios",
      "labels": ["自動マージ"],
      "automerge": true
    },
    {
      "description": "開発用の依存のパッチ・マイナー。npm 自体（package.json の packageManager）もここに入る",
      "matchDepTypes": ["devDependencies", "packageManager"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "開発用の依存",
      "groupSlug": "dev-tools",
      "labels": ["自動マージ"],
      "automerge": true
    },
    {
      "description": "GitHub Actions の部品（メジャーも。壊れれば CI 自体が落ちる）",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "labels": ["自動マージ"],
      "automerge": true
    },
    {
      "description": "メジャーは1件ずつ、移行の手順を読み、コードを直してから人が入れる",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "labels": ["要検討：メジャー"],
      "automerge": false
    },
    {
      "description": "Expo の SDK が版を決めている依存には触らない。Expo は SDK ごとに動作を確かめた版の組み合わせを持っていて、それを知っているのは Expo のコマンドだけなので、npx expo install --fix（SDK の中）と SDK を上げる作業で揃える。中身は expo の bundledNativeModules.json に載っている依存と expo 本体で、npm run check:renovate-expo が実際の依存との一致を確かめる",
      "matchPackageNames": [
        "@react-native-async-storage/async-storage",
        "@react-native-community/datetimepicker",
        "eslint-config-expo",
        "expo",
        "expo-apple-authentication",
        "expo-application",
        "expo-build-properties",
        "expo-clipboard",
        "expo-constants",
        "expo-crypto",
        "expo-dev-client",
        "expo-file-system",
        "expo-font",
        "expo-glass-effect",
        "expo-haptics",
        "expo-image-manipulator",
        "expo-image-picker",
        "expo-linking",
        "expo-localization",
        "expo-location",
        "expo-router",
        "expo-splash-screen",
        "expo-status-bar",
        "expo-system-ui",
        "react",
        "react-dom",
        "react-native",
        "react-native-gesture-handler",
        "react-native-maps",
        "react-native-reanimated",
        "react-native-safe-area-context",
        "react-native-screens",
        "react-native-svg",
        "react-native-worklets"
      ],
      "enabled": false
    },
    {
      "description": "アプリ（apps/mobile）の開発用の依存のうち、Expo が SDK ごとに版を決めているもの（Expo の relatedPackages）。揃えるのは .github/workflows/expo-sdk-patch.yml の npx expo install --fix。web 側の同じ部品は上の規則どおり Renovate が上げる",
      "matchFileNames": ["apps/mobile/package.json"],
      "matchPackageNames": ["@types/react", "typescript"],
      "enabled": false
    },
    {
      "description": "型定義は動かしている Node（24）に合わせる",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<25"
    }
  ],
  "vulnerabilityAlerts": {
    "description": "セキュリティの修正。見つかった時にすぐ出す。Renovate はこれを packageRules の後に強制で当てるので、上の規則（メジャーは人が見る等）より優先される",
    "labels": ["セキュリティ", "自動マージ"],
    "automerge": true
  },
  "lockFileMaintenance": {
    "description": "lockfile を作り直し、間接の依存（Expo の部品の SDK の中の更新を含む）を範囲内の最新にする。間接の依存のセキュリティの修正もここで入る",
    "enabled": true,
    "schedule": ["before 9am on monday"],
    "labels": ["自動マージ"],
    "automerge": true
  }
}
