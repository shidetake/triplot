// 依存の更新の PR を Renovate に出させる。CI が通れば自動で入れ、人が見るのはメジャーだけ
// （docs/development.md の「依存の更新」）。packageRules は後に書いたものが前のものを上書きする。
// コメントを書けるように JSON5 にしてある（足し引きした部品の理由を1行ずつ残すため）。
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  timezone: "Asia/Tokyo",
  schedule: ["before 9am on monday"],
  minimumReleaseAge: "7 days",
  prConcurrentLimit: 20,
  packageRules: [
    {
      description: "web の本番の依存のパッチ・マイナー",
      matchDepTypes: ["dependencies"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "web の本番の依存",
      groupSlug: "web",
      labels: ["自動マージ"],
      automerge: true,
    },
    {
      description: "iOS でだけ使う依存のうち、Expo の SDK が版を決めていないもの",
      matchDepTypes: ["dependencies"],
      matchPackageNames: ["@react-native-google-signin/*", "@tanstack/react-query", "use-intl"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "iOS の依存",
      groupSlug: "ios",
      labels: ["自動マージ"],
      automerge: true,
    },
    {
      description: "開発用の依存のパッチ・マイナー。npm 自体（package.json の packageManager）もここに入る",
      matchDepTypes: ["devDependencies", "packageManager"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "開発用の依存",
      groupSlug: "dev-tools",
      labels: ["自動マージ"],
      automerge: true,
    },
    {
      description: "GitHub Actions の部品（メジャーも。壊れれば CI 自体が落ちる）",
      matchManagers: ["github-actions"],
      groupName: "GitHub Actions",
      groupSlug: "github-actions",
      labels: ["自動マージ"],
      automerge: true,
    },
    {
      description: "メジャーは1件ずつ、移行の手順を読み、コードを直してから人が入れる。手を付けると決めるまでは Dependency Dashboard に載せるだけで PR を作らない（開いておくと main が動くたびに作り直されてビルドが落ち続ける）",
      matchManagers: ["npm"],
      matchUpdateTypes: ["major"],
      labels: ["要検討：メジャー"],
      automerge: false,
      dependencyDashboardApproval: true,
    },
    {
      description: "Expo の SDK に版が縛られている依存には触らない。版は Expo のコマンド（SDK の中の更新）と SDK を上げる作業で揃える。外すのは「Expo の一覧」＋「名前」＋「足す」−「引く」で、npm run check:renovate-expo が実際の依存と突き合わせる（docs/development.md「Expo の部品」）",
      // 1行に1つ。名前の形（*）が使え、先頭の ! で打ち消す。gitignore と違い順番は関係ない
      // （どれかに当たり、打ち消しのどれにも当たらなければ外れる）。
      matchPackageNames: [
        // ── Expo の一覧：expo の bundledNativeModules.json に載っている依存と expo 本体 ──
        // 手で足し引きしない。書くべき一覧は npm run check:renovate-expo -- --print
        "@react-native-async-storage/async-storage",
        "@react-native-community/datetimepicker",
        "eslint-config-expo",
        "expo",
        "expo-apple-authentication",
        "expo-application",
        "expo-build-properties",
        "expo-clipboard",
        "expo-constants",
        "expo-crypto",
        "expo-dev-client",
        "expo-file-system",
        "expo-font",
        "expo-glass-effect",
        "expo-haptics",
        "expo-image-manipulator",
        "expo-image-picker",
        "expo-linking",
        "expo-localization",
        "expo-location",
        "expo-router",
        "expo-splash-screen",
        "expo-status-bar",
        "expo-system-ui",
        "react",
        "react-dom",
        "react-native",
        "react-native-gesture-handler",
        "react-native-maps",
        "react-native-reanimated",
        "react-native-safe-area-context",
        "react-native-screens",
        "react-native-svg",
        "react-native-worklets",

        // ── 名前：Expo 向けの部品は SDK に縛られていることが多い ──
        "expo-*",
        "@expo/*",

        // ── 足す：上に当たらないが SDK に縛られている部品（理由と見つけた日を添える）──

        // ── 引く：名前で外れたが SDK に縛られていない部品（理由と見つけた日を添える）──
      ],
      enabled: false,
    },
    {
      description: "アプリ（apps/mobile）の開発用の依存のうち、Expo が SDK ごとに版を決めているもの（Expo の relatedPackages）。揃えるのは .github/workflows/expo-sdk-patch.yml の npx expo install --fix。web 側の同じ部品は上の規則どおり Renovate が上げる",
      matchFileNames: ["apps/mobile/package.json"],
      matchPackageNames: ["@types/react", "typescript"],
      enabled: false,
    },
    {
      description: "型定義は動かしている Node（24）に合わせる",
      matchPackageNames: ["@types/node"],
      allowedVersions: "<25",
    },
  ],
  vulnerabilityAlerts: {
    description: "セキュリティの修正。見つかった時にすぐ出す。Renovate はこれを packageRules の後に強制で当てるので、上の規則（メジャーは人が見る等）より優先される",
    labels: ["セキュリティ", "自動マージ"],
    automerge: true,
    dependencyDashboardApproval: false,
  },
  lockFileMaintenance: {
    description: "lockfile を作り直し、間接の依存（Expo の部品の SDK の中の更新を含む）を範囲内の最新にする。間接の依存のセキュリティの修正もここで入る",
    enabled: true,
    schedule: ["before 9am on monday"],
    labels: ["自動マージ"],
    automerge: true,
  },
}
