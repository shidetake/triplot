{
  "name": "triplot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.2.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm -w @triplot/web run dev",
    "dev:mobile": "npm -w @triplot/mobile run start",
    "build": "npm -w @triplot/web run build",
    "start": "npm -w @triplot/web run start",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:db": "npm -w @triplot/shared run test:db",
    "test:watch": "npm -w @triplot/web run test:watch",
    "db:types": "bash scripts/gen-db-types.sh",
    "db:types:check": "bash scripts/check-db-types.sh",
    "check:client-boundary": "node scripts/check-client-boundary.mjs",
    "check:renovate-expo": "node scripts/check-renovate-expo.mjs",
    "check:expo-deps": "EXPO_OFFLINE=1 npm -w @triplot/mobile exec -- expo install --check",
    "db:push:staging": "bash scripts/db-push-staging.sh",
    "check:staging-migrations": "node scripts/check-staging-migrations.mjs",
    "check:no-secrets": "node scripts/check-no-secrets.mjs",
    "workers:deploy": "node scripts/workers-deploy.mjs",
    "gmail:forward": "node scripts/forward-gmail.mjs",
    "licenses:generate": "node scripts/gen-licenses.mjs",
    "web:version:generate": "node scripts/gen-web-version.mjs",
    "ios:preview:upload": "node scripts/ios-preview-upload.mjs",
    "ios:build": "node scripts/ios-build.mjs",
    "ios:submit": "node scripts/ios-submit.mjs",
    "postinstall": "node scripts/apply-patches.mjs",
    "prepare": "husky || true",
    "test:seed-emails": "node scripts/seed-import-emails.mjs",
    "test:import-status": "node scripts/import-status.mjs"
  },
  "dependencies": {
    "patch-package": "^8.0.1"
  },
  "devDependencies": {
    "@vercel/blob": "^2.8.2",
    "husky": "^9.1.7",
    "license-checker-rseidelsohn": "^5.0.1",
    "supabase": "^2.120.0"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "fsevents": false,
    "@swc/core": false,
    "unrs-resolver": false
  }
}
